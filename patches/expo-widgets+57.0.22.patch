+// Hourglass: expo-widgets 56 removed the built-in containerBackground; without one
+// iOS 17+ shows the "adopt containerBackground API" placeholder. Applied natively so
+// it also covers layouts stored by older app versions until the app rewrites them.
+private struct HourglassContainerBackground: ViewModifier {
+  func body(content: Content) -> some View {
+    if #available(iOS 17.0, *) {
+      content.containerBackground(Color(red: 0.051, green: 0.051, blue: 0.102, opacity: 1), for: .widget)
+    } else {
+      content
+    }
+  }
+}
